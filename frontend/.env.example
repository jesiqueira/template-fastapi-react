# ==============================================================================
# CONFIGURAÇÕES DO BANCO DE DADOS (POSTGRES / POSTGIS)
# ==============================================================================
DB_USER=dev
DB_PASSWORD=dev123
DB_NAME=pousada_db
DB_HOST=database
DB_PORT=5432

# ==============================================================================
# CONFIGURAÇÕES DO BACKEND (FASTAPI)
# ==============================================================================
# Gere uma chave aleatória usando: openssl rand -hex 32
SECRET_KEY=sua_chave_secreta_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# URL de conexão que o SQLAlchemy usará internamente
DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ==============================================================================
# CONFIGURAÇÕES DO PGADMIN (GERENCIAMENTO DBA)
# ==============================================================================
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin123

# ==============================================================================
# CONFIGURAÇÕES DO FRONTEND (VITE / REACT)
# ==============================================================================
# Nota: No Vite, as variáveis devem começar com VITE_ para serem expostas
VITE_API_URL=http://localhost:8000/api/v1