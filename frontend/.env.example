# ==============================================================================
# CONFIGURAÇÕES DO FRONTEND (VITE / REACT)
# ==============================================================================
# Nota: No Vite, as variáveis DEVEM começar com VITE_ para serem carregadas.
# Este arquivo contém apenas o que o navegador precisa saber.

# URL de conexão com a API do FastAPI (mapeada via Docker na porta 8000)
VITE_API_URL=http://localhost:8000/api/v1

# Caso pretenda usar mapas do Google futuramente para o Caminho da Fé
# VITE_GOOGLE_MAPS_API_KEY=sua_chave_publica_aqui